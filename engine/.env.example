# --- the coin (pump.fun mint of $SCRAP, paired with SOL, no tax) ---
TOKEN_MINT=
# creator wallet key (bs58 from Phantom/Solflare, or a JSON byte array). Leave the
# placeholder to run in WATCH mode (dry dives, nothing moves). The engine wallet: 100% fee-sharing shareholder (or the creator).
WALLET_PRIVATE_KEY=PASTE_PRIVATE_KEY_HERE
# shown on the page before launch (the real rate is read from the curve once live)
TAX_BPS=0

# --- engine ---
DIVE_INTERVAL_SEC=180
MIN_CLAIM_USD=0.1
MIN_BUY_USD=0.25
GAS_RESERVE_SOL=0.01
MIN_GAS_SOL=0.003
SLIPPAGE_PCT=5
SCHEDULER_ENABLED=true
DRY_RUN=false
POLL_SEC=10

# --- infra ---
PORT=4000
DATABASE_URL=postgres://localhost:5432/scrap
RPC_URL=https://api.mainnet-beta.solana.com

# --- brand ---
BRAND_NAME=SCRAP
SITE_URL=http://localhost:4000
BRAND_TWITTER=
BRAND_TELEGRAM=

# --- fee split (basis points of every claim; a share without a wallet is burned instead) ---
SPLIT_LP_BPS=5000
SPLIT_TREASURY_BPS=2000
SPLIT_AIRDROP_BPS=2000
SPLIT_BURN_BPS=1000
LP_WALLET=
TREASURY_WALLET=
AIRDROP_HOLDERS=20
MIN_TRANSFER_SOL=0.002

# --- liquidity (optional): with the reserve wallet's key the engine deposits the reserve into the
# PumpSwap pool after graduation and burns the LP tokens; without it the reserve only accumulates ---
LP_WALLET_PRIVATE_KEY=
LP_MIN_DEPOSIT_SOL=0.1
LP_RESERVE_SOL=0.02
LP_BUY_BPS=4800

# --- community (weekly Dumpster Dive vote, Recycle a Rug, badges) ---
# with the treasury key the engine settles each week by itself; without it votes are only collected
TREASURY_WALLET_PRIVATE_KEY=
DONATION_WALLET=
ADMIN_TOKEN=
COMMUNITY_MIN_HOLD=100000
VOTE_SLICE_BPS=2500
ROAST_PRIZE_BPS=1000
